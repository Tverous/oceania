{
  "display_information": { "name": "Tower", "description": "Multiplayer mode for the AI agents of your team" },
  "features": {
    "app_home": { "home_tab_enabled": true, "messages_tab_enabled": false },
    "bot_user": { "display_name": "Tower", "always_online": true }
  },
  "oauth_config": {
    "scopes": { "bot": ["channels:join", "channels:manage", "channels:read", "chat:write", "users:read", "users:read.email"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_home_opened"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
